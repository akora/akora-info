---
import LetterGlitch from "../components/letter-glitch.astro";
import Projects from "../components/home/projects.astro";
import Separator from "../components/home/separator.astro";
import Writings from "../components/home/writings.astro";
import Layout from "../layouts/main.astro";

const launchDateUtc = {
  year: 2006,
  monthIndex: 8,
  day: 18,
  hour: 8,
  minute: 28,
  second: 1,
};

const showBlogFeed = false;
---

<Layout title="AKora.info • The project portfolio site of Andras Kora">
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
  >
    <div class="flex flex-col items-center gap-10 md:flex-row md:items-center md:gap-12">
      <div class="relative w-full max-w-3xl text-center md:w-3/5 md:text-left">
        <h1 class="mb-5 text-2xl font-bold leading-tight md:text-3xl lg:text-4xl dark:text-white">Welcome to akora.info</h1>
        <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
          This domain has been my digital home for <span id="domain-age-years" class="inline-block rounded-full border border-neutral-300 bg-neutral-100 px-2 py-0.5 text-sm font-semibold leading-none text-neutral-800 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-100 align-baseline cursor-help" title="Calculated automatically from 2006-09-18 08:28:01 UTC" aria-label="Dynamically calculated domain age in years">19</span> years. Since 2006, it has hosted countless experiments, side projects, and ideas.</br></br>
          Today, it serves as a permanent showcase for my latest builds.</br></br>
          Feel free to explore the live projects below - you might just find something worth checking out.
        </p>
      </div>
      <div class="relative w-full max-w-xs md:w-2/5 md:max-w-sm p-3 group">
        <span
          class="absolute inset-0 z-20 block w-full h-full duration-300 ease-out bg-transparent border border-transparent border-dashed group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border group-hover:border-neutral-300 dark:group-hover:border-neutral-600 rounded-2xl"
        ></span>
        <span
          class="absolute inset-0 z-10 block w-full h-full duration-300 ease-out border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-600 group-hover:translate-x-1 group-hover:translate-y-1"
        ></span>
        <img
          src="/assets/images/profile/Andras-KORA-profile-photo-004-800x800.jpg"
          alt="Portrait photo of Andras Kora"
          loading="eager"
          decoding="async"
          class="relative z-30 w-full h-auto object-cover rounded-2xl duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1"
        />
      </div>
    </div>
  </div>

  <div class="relative w-full max-w-4xl mx-auto px-7 xl:px-0">
    <div class="absolute -top-4 left-0 dark:hidden z-10">
      <p class="text-xs text-neutral-500 italic">
        Switch to night mode, it looks so much cooler!
      </p>
    </div>
    <LetterGlitch 
      className="w-full" 
      useRandomScheme={true}
      lines={4} 
      glitchSpeed={100}
    />
  </div>

  <Separator text="Projects" spacingClass="mt-10 mb-24" targetId="projects" />
  <Projects />
  {
    showBlogFeed && (
      <>
        <Separator text="Blog Feed" spacingClass="my-24" />
        <Writings />
      </>
    )
  }
</Layout>

<script is:inline define:vars={{ launchDateUtc }}>
  const yearsElement = document.getElementById("domain-age-years");

  if (yearsElement) {
    const startDate = new Date(
      Date.UTC(
        launchDateUtc.year,
        launchDateUtc.monthIndex,
        launchDateUtc.day,
        launchDateUtc.hour,
        launchDateUtc.minute,
        launchDateUtc.second,
      ),
    );

    const now = new Date();
    let years = now.getUTCFullYear() - startDate.getUTCFullYear();

    const anniversaryThisYear = new Date(
      Date.UTC(
        now.getUTCFullYear(),
        launchDateUtc.monthIndex,
        launchDateUtc.day,
        launchDateUtc.hour,
        launchDateUtc.minute,
        launchDateUtc.second,
      ),
    );

    if (now < anniversaryThisYear) {
      years -= 1;
    }

    yearsElement.textContent = String(Math.max(0, years));
  }
</script>
