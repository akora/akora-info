---
import Logo from "../components/logo.astro";

const socialLinks = [
  { name: "GitHub", href: "https://github.com/akora", iconClass: "fa-brands fa-github" },
  { name: "X", href: "https://x.com/AndrasKora", iconClass: "fa-brands fa-x-twitter" },
  { name: "Bluesky", href: "https://bsky.app/profile/andraskora.bsky.social", iconClass: "fa-brands fa-bluesky" },
  { name: "Mastodon", href: "https://mastodon.social/@akora", iconClass: "fa-brands fa-mastodon" },
  { name: "TikTok", href: "https://www.tiktok.com/@andras.kora", iconClass: "fa-brands fa-tiktok" },
  { name: "LinkedIn", href: "https://www.linkedin.com/in/andraskora/", iconClass: "fa-brands fa-linkedin" },
  { name: "Facebook", href: "https://www.facebook.com/andras.kora", iconClass: "fa-brands fa-facebook-f" },
  { name: "Website", href: "https://andraskora.com/", iconClass: "fa-solid fa-globe" },
  { name: "YouTube", href: "https://www.youtube.com/@andraskora", iconClass: "fa-brands fa-youtube" },
  { name: "Email", href: "mailto:ak@akora.info", iconClass: "fa-solid fa-envelope" },
];
---

<section
  class="text-gray-700 bg-white border-t sm:mt-20 dark:bg-neutral-950 border-neutral-200 dark:border-neutral-800"
>
  <div
    class="container flex flex-col items-center py-8 mx-auto px-7 max-w-7xl sm:flex-row"
  >
    <Logo />
    <p
      class="mt-4 text-sm text-neutral-700 dark:text-neutral-100 sm:ml-4 sm:pl-4 sm:border-l sm:border-neutral-300 dark:sm:border-neutral-700 sm:mt-0"
    >
      © {new Date().getFullYear()} Andras Kora · Theme based on
      <a
        href="https://github.com/miantiao-me/astro-aria"
        target="_blank"
        class="underline hover:text-neutral-900 dark:hover:text-white">astro-aria</a> by miantiao-me
    </p>

    <span
      class="inline-flex justify-center mt-4 space-x-5 sm:ml-auto sm:mt-0 sm:justify-start"
    >
      {
        socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-all duration-200 ease-out hover:-translate-y-0.5"
          >
            <i class={`${social.iconClass} text-2xl`} aria-hidden="true"></i>
          </a>
        ))
      }
    </span>
  </div>
</section>
